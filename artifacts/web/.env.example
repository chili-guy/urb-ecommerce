# Copie para artifacts/web/.env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A anon key é pública — a RLS é o que protege os dados.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Rastreamento (todos opcionais — deixe em branco/remova o que não usar).
# Sem nenhum preenchido, lib/analytics.ts não carrega nenhum script de terceiro.
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
VITE_META_PIXEL_ID=000000000000000
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
